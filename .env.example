# Copy to .env on the NAS. Never commit .env.
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
HG_PORT=3000

# Logging: postgres (default), stdout, otel; comma-separated.
HG_LOG_SINKS=postgres
# OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm.lan:4318

# Deploy agent (compose profile "deploy")
GITHUB_REPO=your-user/homegrown
# Fine-grained token: read checks, write commit statuses and PR comments. Only the deploy agent sees it.
GITHUB_TOKEN=
HG_BACKUP_DIR=./backups
